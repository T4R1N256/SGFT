# Copy this file to .env and fill in real values. NEVER commit .env (CLAUDE.md §10).

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# True only on your machine. Production must use False.
DJANGO_DEBUG=True

# Comma-separated lists.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Only if the hosting provider does not force HTTPS by itself.
DJANGO_SECURE_SSL_REDIRECT=False

# PostgreSQL connection string (Neon or Supabase in production, WBS 5.2).
DATABASE_URL=postgres://sgft:sgft@localhost:5432/sgft
# For a quick local run without PostgreSQL you may use SQLite instead.
# CI and production always use PostgreSQL.
# DATABASE_URL=sqlite:///db.sqlite3
